classDiagram
direction TB
class Student {
  + constructor(uid, name, email)
  + getDashboardPath()
}
class Librarian {
  + constructor(uid, name, email)
  + getDashboardPath()
}
class Book {
  - data
  - registered
  + title {readOnly}
  + author {readOnly}
  + category {readOnly}
  + color {readOnly}
  + ink {readOnly}
  + availableCopies {readOnly}
  + constructor(id, data, registered = false)
  + isAvailable()
  + getSummary()
  + matchesSearch(searchText)
  + matchesCategory(category)
}
class StudentProfile {
  - user
  - data
  + fullName {readOnly}
  + studentId {readOnly}
  + course {readOnly}
  + email {readOnly}
  + emailVerified {readOnly}
  + constructor(user, data)
  + getSummary()
  + isComplete()
  + toData()
  + validate(fullName, studentId, course)$
}
class AdminProfile {
  - data
  + name {readOnly}
  + email {readOnly}
  + verified {readOnly}
  + photoURL {readOnly}
  + constructor(user)
  + getSummary()
}
class AdminBook {
  - data
  - copies
  - registered
  + title {readOnly}
  + author {readOnly}
  + category {readOnly}
  + color {readOnly}
  + ink {readOnly}
  + availableCopies {readOnly}
  + registered {readOnly}
  + constructor(id, data, registered = true)
  + getSummary()
  + isInventoryValid()
  + issueCopy()
  + addCopies(count)
  + returnCopy()
  + toDocument()
}
class LoginService {
  - auth
  - db
  + constructor(auth, db)
  + register(name, email, password)
  + login(email, password, remember)
  + getAccount(user)
  + resendVerification(email, password)
  + resetPassword(email)
  + openDashboard(account)
}
class CatalogueService {
  + normalize(value)$
  + getBooks(samples, inventory)
}
class StudentProfileService {
  - db
  - auth
  + constructor(db, auth)
  - assertSession(user)
  + listen(user, onProfile, onError)
  + save(user, fullName, studentId, course)
}
class BorrowingService {
  - db
  - auth
  + constructor(db, auth)
  - assertSession(user)
  + requestBook(user, profile, bookId)
  + cancelRequest(user, requestId)
}
class AdminProfileService {
  - auth
  + constructor(auth)
  + updateName(profile, name)
}
class AdminBorrowingService {
  - db
  - auth
  + constructor(db, auth)
  - assertActor(profile)
  + approve(profile, requestId, dueAt)
  + reject(profile, requestId, reason)
  + returnBook(profile, requestId)
  - validateDueDate(dueAt)
  - process(profile, requestId, action, reason, dueAt = null)
}
class AdminCatalogueService {
  - db
  - auth
  - lastColor
  + constructor(db, auth)
  + getBooks(samples, inventory)
  + addBook(profile, values, usedColors)
  + updateBook(profile, bookId, values)
  + removeBook(profile, book)
}
class AdminFilterService {
  - collator
  + normalize(value)$
  + matches(query, fields)$
  + books(records, query, category, order)
  + transactions(records, query, order, profileFor, titleFor)
}
class LibraryUser {
  <<abstract>>
  - uid
  - name
  - email
  + constructor(uid, name, email)
  + getUid()
  + getDisplayName()
  + getEmail()
  + getDashboardPath()
}
class LibraryRecord {
  <<abstract>>
  - id
  + id {readOnly}
  + constructor(id)
  + getId()
  + getSummary()
}
class AdminRecord {
  <<abstract>>
  - id
  + id {readOnly}
  + constructor(id)
  + getId()
  + getSummary()
}
class PasswordPolicy {
  + check(password)$
  + isValid(password)$
}
class BookCoverPalette {
  - colors$
  + pick(usedColors, lastColor)$
}
class LoginController {
  - service
  - ui
  - registering
  - busy
  + constructor(service)
  + start()
  - setMode(registering)
  - setBusy(busy)
  - notify(text, type = "success")
  - updateRequirements()
  - validEmail()
  - submit()
  - resetPassword()
  - resend()
  - errorText(error)
}
LibraryUser <|-- Student
LibraryUser <|-- Librarian
LibraryRecord <|-- Book
LibraryRecord <|-- StudentProfile
AdminRecord <|-- AdminProfile
AdminRecord <|-- AdminBook
LoginController --> LoginService : holds
LoginController ..> PasswordPolicy : validates
LoginController ..> LibraryUser : reads account
LoginService ..> PasswordPolicy : validates
LoginService ..> Student : creates
LoginService ..> Librarian : creates
LoginService ..> LibraryUser : checks account type
CatalogueService ..> Book : creates
StudentProfileService ..> StudentProfile : creates / validates
BorrowingService ..> StudentProfile : checks completeness
BorrowingService ..> Book : checks availability
AdminProfileService ..> AdminProfile : updates / creates
AdminBorrowingService ..> AdminProfile : checks actor
AdminBorrowingService ..> AdminBook : issues / returns copies
AdminCatalogueService ..> AdminProfile : checks actor
AdminCatalogueService ..> AdminBook : creates / edits / removes
AdminCatalogueService ..> BookCoverPalette : chooses cover
AdminFilterService ..> AdminBook : filters / sorts
